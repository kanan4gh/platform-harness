__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
.pytest_cache/
.pyright/
.claude/settings.local.json

# フックの揮発状態(セッションローカル)
.claude/hooks/state/

# ステアリング作業ディレクトリはテンプレート複製対象外
.steering/*
!.steering/example/

# 入れ子の作業ツリー(EnterWorktree が作るリポジトリ内checkout)
# 無視しないと、.gitignore を尊重するツール(ruff等)が作業ツリー内の
# checkout全体を走査し、無関係な作業ツリーの状態でゲート結果が変わる
.claude/worktrees/
